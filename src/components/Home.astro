---
import { getCollection } from 'astro:content';
import source from '../data/source.json';
import families from '../data/sidebar.json';
import { tr } from '../lib/i18n.js';
const lng = Astro.locals.starlightRoute?.lang === 'fr' ? 'fr' : 'en';
const t = (en: string, vars?: Record<string, unknown>) => tr(lng, en, vars);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// the French pages are under fr/, the English ones at the root
const pre = lng === 'fr' ? 'fr/' : '';
const docs = (await getCollection('docs')).filter(d => (lng === 'fr') === d.id.startsWith('fr/'));
const FAMILIES = families.map((f: any) => (lng === 'fr' && f.translations?.fr) || f.label);
const machines = docs
  .filter(d => d.data.machine && !(d.data.machine.structure && d.data.machine.id !== 'ore_refinery_controller'))
  .map(d => ({ d, fam: d.data.machine!.family ?? '', order: d.data.sidebar?.order ?? 9 }))
  .sort((a, b) => FAMILIES.indexOf(a.fam) - FAMILIES.indexOf(b.fam) || a.order - b.order);
const pic = (m: any) => m.id === 'ore_refinery_controller' ? '_refinery' : (m.model ?? m.id);
const guides = docs.filter(d => d.id.startsWith(pre + 'guides/')).sort((a, b) => (a.data.sidebar?.order ?? 9) - (b.data.sidebar?.order ?? 9));
const byId = (id: string) => docs.find(d => d.id === id || d.id === pre + id);
const tiles = ([['Overview', 'overview'], ['Basics', 'getting-started'], ...guides.map(g => ['Guide', g.id]), ['Reference', 'crafting'],
  ['Reference', 'in-game-texts'], ['Reference', 'configuration'], ['Help', 'faq']] as [string, string][])
  .map(([k, id]) => [k, byId(id)] as const).filter((t): t is readonly [string, NonNullable<ReturnType<typeof byId>>] => !!t[1]);
const short = (s = '') => (s.length > 110 ? s.slice(0, s.lastIndexOf(' ', 106)) + '…' : s);
---

<div class="me-home not-content">
  <section class="me-hero">
    <div>
      <div class="me-eyebrow">{t('Mekanism addon')} · <span style="text-transform:none">v{source.modVersion}</span> · <span style="white-space:nowrap">Minecraft {source.builds.map(b => b.minecraft).join(' & ')}</span></div>
      <h1 set:html={t('Engineering,<br />at quantum scale.')} />
      <p>{t('Remote mining, whole-chain ore refining, quantum networks and precise logistics. The complete wiki of Mekanism: Engineering.')}</p>
      <div class="me-cta">
        <a class="me-btn primary" href={`${base}/${pre}overview/`}>{t('Start here →')}</a>
        <a class="me-btn" href={`${base}/${pre}guides/first-ore-refinery/`}>{t('First refinery')}</a>
        <a class="me-btn" href="https://www.curseforge.com/minecraft/mc-mods/mekanism-engineering">CurseForge ↗</a>
      </div>
    </div>
    <div data-me3d data-kind="refinery" data-mode="assembled" data-tags="hero">
      <div class="me-stage"><img src={`${base}/icons/mekanismengineering/_refinery.png`} alt={t('The Quantum Ore Refinery')} style="width:100%;height:100%;object-fit:contain" /></div>
    </div>
  </section>

  <h2>{t('The machines')}</h2>
  <p class="me-sub">{t('{n} machines and tools. Blue: Quantum. Grey: Mekanism style.', { n: machines.length })}</p>
  <div class="me-rail-wrap">
  <button type="button" class="me-rail-btn prev" aria-label={t('Previous machines')}>←</button>
  <button type="button" class="me-rail-btn next" aria-label={t('Next machines')}>→</button>
  <div class="me-rail">
    {machines.map(({ d, fam }) => (
      <a class:list={['me-card', { g: !d.data.machine!.quantum }]} href={`${base}/${d.id}/`}>
        <div class="me-eyebrow">{fam}{d.data.machine!.isNew ? ` · ${t('new')}` : ''}</div>
        <img class:list={{ flat: !d.data.machine!.model && !d.data.machine!.structure && !d.data.machine!.photo }} src={`${base}/icons/mekanismengineering/${pic(d.data.machine)}.png`} alt="" loading="lazy" />
        <h3>{d.data.title}</h3>
        <p>{short(d.data.description)}</p>
      </a>
    ))}
  </div>
  </div>

  <h2>{t('Start here')}</h2>
  <p class="me-sub">{t('New to the mod? These pages take you from your first machine to a working setup.')}</p>
  <div class="me-tiles">
    {tiles.map(([kind, d]) => (
      <a class="me-tile" href={`${base}/${d.id}/`}><div class="me-eyebrow">{t(kind)}</div><h3>{d.data.title}</h3><p>{short(d.data.description)}</p></a>
    ))}
  </div>
</div>

<script>
  for (const wrap of document.querySelectorAll('.me-rail-wrap')) {
    const rail = wrap.querySelector('.me-rail') as HTMLElement;
    wrap.querySelector('.prev')?.addEventListener('click', () => rail.scrollBy({ left: -rail.clientWidth * 0.8, behavior: 'smooth' }));
    wrap.querySelector('.next')?.addEventListener('click', () => rail.scrollBy({ left: rail.clientWidth * 0.8, behavior: 'smooth' }));
  }
</script>
