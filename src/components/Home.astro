---
import { getCollection } from 'astro:content';
import source from '../data/source.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = await getCollection('docs');
import families from '../data/sidebar.json';
const FAMILIES = families.map(f => f.label);
const machines = docs
  .filter(d => d.data.machine && !(d.data.machine.structure && d.data.machine.id !== 'ore_refinery_controller'))
  .map(d => ({ d, fam: d.data.machine!.family ?? '', order: d.data.sidebar?.order ?? 9 }))
  .sort((a, b) => FAMILIES.indexOf(a.fam) - FAMILIES.indexOf(b.fam) || a.order - b.order);
const pic = (m: any) => m.id === 'ore_refinery_controller' ? '_refinery' : (m.model ?? m.id);
const guides = docs.filter(d => d.id.startsWith('guides/')).sort((a, b) => (a.data.sidebar?.order ?? 9) - (b.data.sidebar?.order ?? 9));
const byId = (id: string) => docs.find(d => d.id === id);
const tiles = ([['Overview', 'overview'], ['Basics', 'getting-started'], ...guides.map(g => ['Guide', g.id]), ['Reference', 'crafting'],
  ['Reference', 'in-game-texts'], ['Reference', 'configuration'], ['Help', 'faq']] as [string, string][])
  .map(([k, id]) => [k, byId(id)] as const).filter((t): t is readonly [string, NonNullable<ReturnType<typeof byId>>] => !!t[1]);
const short = (s = '') => (s.length > 110 ? s.slice(0, s.lastIndexOf(' ', 106)) + '…' : s);
---

<div class="me-home not-content">
  <section class="me-hero">
    <div>
      <div class="me-eyebrow">Mekanism addon · <span style="text-transform:none">v{source.modVersion}</span> · Minecraft {source.minecraft}</div>
      <h1>Engineering,<br />at quantum scale.</h1>
      <p>Remote mining, whole-chain ore refining, quantum networks and precise logistics. The complete wiki of Mekanism: Engineering.</p>
      <div class="me-cta">
        <a class="me-btn primary" href={`${base}/overview/`}>Start here →</a>
        <a class="me-btn" href={`${base}/guides/first-ore-refinery/`}>First refinery</a>
        <a class="me-btn" href="https://www.curseforge.com/minecraft/mc-mods/mekanism-engineering">CurseForge ↗</a>
      </div>
    </div>
    <div data-me3d data-kind="refinery" data-mode="assembled" data-tags="hero">
      <div class="me-stage"><img src={`${base}/icons/mekanismengineering/_refinery.png`} alt="The Quantum Ore Refinery" style="width:100%;height:100%;object-fit:contain" /></div>
    </div>
  </section>

  <h2>The machines</h2>
  <p class="me-sub">{machines.length} machines and tools. Blue: Quantum. Grey: Mekanism style.</p>
  <div class="me-rail-wrap">
  <button type="button" class="me-rail-btn prev" aria-label="Previous machines">←</button>
  <button type="button" class="me-rail-btn next" aria-label="Next machines">→</button>
  <div class="me-rail">
    {machines.map(({ d, fam }) => (
      <a class:list={['me-card', { g: !d.data.machine!.quantum }]} href={`${base}/${d.id}/`}>
        <div class="me-eyebrow">{fam}{d.data.machine!.isNew ? ' · new' : ''}</div>
        <img class:list={{ flat: !d.data.machine!.model && !d.data.machine!.structure }} src={`${base}/icons/mekanismengineering/${pic(d.data.machine)}.png`} alt="" loading="lazy" />
        <h3>{d.data.title}</h3>
        <p>{short(d.data.description)}</p>
      </a>
    ))}
  </div>
  </div>

  <h2>Start here</h2>
  <p class="me-sub">New to the mod? These pages take you from your first machine to a working setup.</p>
  <div class="me-tiles">
    {tiles.map(([kind, d]) => (
      <a class="me-tile" href={`${base}/${d.id}/`}><div class="me-eyebrow">{kind}</div><h3>{d.data.title}</h3><p>{short(d.data.description)}</p></a>
    ))}
  </div>
</div>

<script>
  for (const wrap of document.querySelectorAll('.me-rail-wrap')) {
    const rail = wrap.querySelector('.me-rail') as HTMLElement;
    wrap.querySelector('.prev')?.addEventListener('click', () => rail.scrollBy({ left: -rail.clientWidth * 0.8, behavior: 'smooth' }));
    wrap.querySelector('.next')?.addEventListener('click', () => rail.scrollBy({ left: rail.clientWidth * 0.8, behavior: 'smooth' }));
  }
</script>
