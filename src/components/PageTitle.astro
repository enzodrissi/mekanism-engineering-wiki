---
import Default from '@astrojs/starlight/components/PageTitle.astro';
const { entry, id } = Astro.locals.starlightRoute;
const m = entry.data.machine;
const FAMILY: Record<string, string> = {
  'ore-refining': 'Ore refining', mining: 'Mining', 'quantum-network': 'Quantum network', teleportation: 'Teleportation',
  charging: 'Charging', 'fluids-and-rocks': 'Fluids and rocks', logistics: 'Logistics',
};
const family = FAMILY[id.split('/')[1]] ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// the refinery gets the full 3D viewer under its title, a block turns in 3D, an item shows its inventory picture
const kind = !m ? null : m.id === 'ore_refinery_controller' ? 'refinery' : m.structure ? null : m.model ? 'block' : 'item';
const item = m?.model ?? m?.id;
---

{
  id === '' || id === 'index' ? null : m ? (
    <div class:list={['me-head', m.quantum ? 'q' : 'g', { wide: kind === 'refinery' }]}>
      <div>
        <div class="me-eyebrow">{family}{m.isNew ? ' · New' : ''}{m.quantum ? ' · Quantum' : ''}</div>
        <h1 id="_top">{entry.data.title}</h1>
        {entry.data.description && <p class="me-lead">{entry.data.description}</p>}
      </div>
      {kind === 'refinery' && <div class="not-content" data-me3d data-kind="refinery" data-mode="exploded" />}
      {kind === 'block' && (
        <div class="me-head-visual not-content">
          <div class="me-stage" data-me3d data-kind="block" data-item={item}>
            <img src={`${base}/icons/mekanismengineering/${item}.png`} alt="" style="width:min(12rem,60%);margin:auto;display:block;image-rendering:pixelated" />
            <span class="me-pill me-hint">⟲ Drag to turn</span>
          </div>
        </div>
      )}
      {kind === 'item' && (
        <div class="me-head-visual not-content">
          <img src={`${base}/icons/mekanismengineering/${item}.png`} alt={entry.data.title} />
        </div>
      )}
    </div>
  ) : (
    <Default />
  )
}

<style>
  .wide { grid-template-columns: 1fr !important; }
  .me-stage > img { position: absolute; inset: 0; height: 100%; object-fit: contain; }
</style>
