---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { tr } from '../lib/i18n.js';
import { featuresOf, hasSection, FILTER_ICON } from '../lib/features.mjs';
const { entry, id, lang } = Astro.locals.starlightRoute;
const t = (en: string) => tr(lang === 'fr' ? 'fr' : 'en', en);
const m = entry.data.machine;
const family = m?.family ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// the refinery gets the full 3D viewer under its title, a block turns in 3D, an item shows its inventory picture
// the Companion is an item, but its page shows it at work: in front of the Quantum Digital Miner it is linked to (src/lib/anim/miner.js)
const scene = m?.id === 'digital_miner_surveyor' ? { item: 'quantum_digital_miner', focus: 'companion' } : null;
const kind = !m ? null : m.id === 'ore_refinery_controller' ? 'refinery' : m.structure ? null : m.model || scene ? 'block' : 'item';
const item = m?.model ?? m?.id;
// a big addition of this page (src/lib/features.mjs): a banner under the header leads to its section
const feats = featuresOf(id.replace(/^fr\//, ''), lang === 'fr' ? 'fr' : 'en').filter(f => hasSection(entry.body, f));
---

{
  ['', 'index', 'fr', 'fr/index'].includes(id) ? null : m ? (
    <div class="me-head-c">
    <div class:list={['me-head', m.quantum ? 'q' : 'g', { wide: kind === 'refinery' }]}>
      <div>
        <div class="me-eyebrow">{family}{m.isNew ? ` · ${t('New')}` : ''}{m.quantum ? ' · Quantum' : ''}</div>
        <h1 id="_top">{entry.data.title}</h1>
        {entry.data.description && <p class="me-lead">{entry.data.description}</p>}
        {feats.map(f => (
          <a class="me-new not-content" href={`#${f.anchor}`}>
            <span class="me-new-icon" set:html={FILTER_ICON} />
            <span class="me-new-text">
              <span class="me-eyebrow">{f.badge}</span>
              <b>{f.title}</b>
              <span class="me-new-lead">{f.lead}</span>
            </span>
            <span class="me-new-go">{f.more} ↓</span>
          </a>
        ))}
      </div>
      {kind === 'refinery' && <div class="not-content" data-me3d data-kind="refinery" data-mode="exploded" />}
      {kind === 'refinery' && (
        <section class="me-build not-content" id="how-to-build-it" aria-labelledby="how-to-build-it-h">
          <h2 id="how-to-build-it-h">{t('How to build it')}</h2>
          <p class="me-build-lead">{t('Block by block, in an order that is easy in game. Stand in front of the controller: left and right are yours, and layer 1 is the bottom one. Only the kind of block matters in each cell, not the way it faces.')}</p>
          <div data-me3d data-kind="build"><div class="me-stage"><div class="me-loading">{t('Loading the 3D view…')}</div></div></div>
        </section>
      )}
      {kind === 'block' && (
        <div class="me-head-visual not-content">
          <div class="me-stage" data-me3d data-kind="block" data-item={scene?.item ?? item} data-focus={scene?.focus}>
            <img src={`${base}/icons/mekanismengineering/${item}.png`} alt="" style="width:min(12rem,60%);margin:auto;display:block;image-rendering:pixelated" />
            <span class="me-pill me-hint">{t('⟲ Drag to turn')}</span>
          </div>
        </div>
      )}
      {kind === 'item' && (
        <div class="me-head-visual not-content">
          <img src={`${base}/icons/mekanismengineering/${item}.png`} alt={entry.data.title} />
        </div>
      )}
    </div>
    </div>
  ) : (
    <Default />
  )
}

<style>
  .wide { grid-template-columns: 1fr !important; }
  .me-stage > img { position: absolute; inset: 0; height: 100%; object-fit: contain; }
</style>
